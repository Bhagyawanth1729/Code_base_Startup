# Application
APP_ENV=development
HTTP_PORT=8080

# Database
DATABASE_URL=postgres://forgestock:forgestock@localhost:5432/forgestock?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100

# CORS
CORS_ALLOWED_ORIGINS=*